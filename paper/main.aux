\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Regret comparison over $T{=}400$ search steps (50 matched-pair runs, shaded $= \pm 1$ SD). \textbf  {(a)} Cumulative regret: no algorithm dominates significantly in the exploration regime ($T \ll K^D$; Wilcoxon $p{=}0.109$ for DVA vs.\ Uniform). DVA achieves $98\%$ accuracy, Uniform and Random achieve $100\%$ (Table~\ref {tab:summary}). \textbf  {(b)} Log-log scaling: empirical slope $0.635$ ($R^2{=}0.961$), above the asymptotic $0.5$ prediction due to exploration-regime overhead (Remark~\ref {rem:exploration}). }}{18}{figure.caption.5}\protected@file@percent }
\newlabel{fig:regret}{{1}{18}{Regret comparison over $T{=}400$ search steps (50 matched-pair runs, shaded $= \pm 1$ SD). \textbf {(a)} Cumulative regret: no algorithm dominates significantly in the exploration regime ($T \ll K^D$; Wilcoxon $p{=}0.109$ for DVA vs.\ Uniform). DVA achieves $98\%$ accuracy, Uniform and Random achieve $100\%$ (Table~\ref {tab:summary}). \textbf {(b)} Log-log scaling: empirical slope $0.635$ ($R^2{=}0.961$), above the asymptotic $0.5$ prediction due to exploration-regime overhead (Remark~\ref {rem:exploration})}{figure.caption.5}{}}
