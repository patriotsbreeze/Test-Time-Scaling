\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Effect of Lipschitz constant specification ($T{=}400$, 50 matched-pair runs; Table~\ref {tab:lhat}). \textbf  {(a)} Grouped bar chart of mean final regret; in the exploration regime, all three configurations perform comparably (no pairwise Wilcoxon test significant at $\alpha {=}0.05$). The adaptive estimator achieves the lowest regret ($23.88$) and $100\%$ accuracy; see Section~\ref {sec:lhat} and Remark~\ref {rem:lhat}. \textbf  {(b)} Regret--calls scatter: adaptive $\hat  {L}$ Pareto-dominates fixed $\hat  {L}$ (lower regret, more calls); both outperform oracle $L$ in this exploration regime. }}{22}{figure.caption.10}\protected@file@percent }
\newlabel{fig:lhat}{{6}{22}{Effect of Lipschitz constant specification ($T{=}400$, 50 matched-pair runs; Table~\ref {tab:lhat}). \textbf {(a)} Grouped bar chart of mean final regret; in the exploration regime, all three configurations perform comparably (no pairwise Wilcoxon test significant at $\alpha {=}0.05$). The adaptive estimator achieves the lowest regret ($23.88$) and $100\%$ accuracy; see Section~\ref {sec:lhat} and Remark~\ref {rem:lhat}. \textbf {(b)} Regret--calls scatter: adaptive $\hat {L}$ Pareto-dominates fixed $\hat {L}$ (lower regret, more calls); both outperform oracle $L$ in this exploration regime}{figure.caption.10}{}}
