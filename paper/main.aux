\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Regret comparison over $T=500$ search steps (50 independent runs, shaded = $\pm $1 SD). \textbf  {(a)} Cumulative regret: DVA-MCTS achieves substantially lower cumulative regret than Uniform Verification despite fewer verifier calls. \textbf  {(b)} Log-log scaling confirms the $O(\sqrt  {T})$ rate for DVA-MCTS (slope $\approx 0.5$), matching Theorem~\ref {thm:main}. }}{14}{figure.caption.4}\protected@file@percent }
\newlabel{fig:regret}{{1}{14}{Regret comparison over $T=500$ search steps (50 independent runs, shaded = $\pm $1 SD). \textbf {(a)} Cumulative regret: DVA-MCTS achieves substantially lower cumulative regret than Uniform Verification despite fewer verifier calls. \textbf {(b)} Log-log scaling confirms the $O(\sqrt {T})$ rate for DVA-MCTS (slope $\approx 0.5$), matching Theorem~\ref {thm:main}}{figure.caption.4}{}}
